{
  "inbounds": [
    {
      "type": "shadowtls",
      "tag": "shadowtls-in",
      "listen": "0.0.0.0",
      "listen_port": 443,
      "version": 3,
      "users": [
        {
          "name": "example-user",
          "password": "REPLACE_WITH_SHADOWTLS_PASSWORD"
        }
      ],
      "handshake": {
        "server": "origin.example.com",
        "server_port": 443
      },
      "detour": "ss-inner"
    },
    {
      "type": "shadowsocks",
      "tag": "ss-inner",
      "listen": "127.0.0.1",
      "listen_port": 8388,
      "method": "chacha20-ietf-poly1305",
      "password": "REPLACE_WITH_SHADOWSOCKS_PASSWORD"
    }
  ]
}
