{
  "services": [
    {
      "name": "vmess-ws-tls-server",
      "addr": "0.0.0.0:8450",
      "listener": {
        "type": "singbox",
        "metadata": {
          "protocol": "vmess",
          "options": {
            "users": [
              {
                "uuid": "00000000-0000-4000-8000-000000000004",
                "alterId": 0
              }
            ],
            "tls": {
              "enabled": true,
              "certificate_path": "/etc/gust/tls/server.crt",
              "key_path": "/etc/gust/tls/server.key"
            },
            "transport": {
              "type": "ws",
              "path": "/vmess-example",
              "max_early_data": 2560,
              "early_data_header_name": "Sec-WebSocket-Protocol"
            }
          }
        }
      },
      "handler": {
        "type": "auto",
        "chain": "direct-chain"
      }
    }
  ],
  "chains": [
    {
      "name": "direct-chain",
      "hops": []
    }
  ]
}
