{
  "type": "tuic",
  "tag": "tuic-in",
  "listen": "0.0.0.0",
  "listen_port": 8445,
  "users": [
    {
      "uuid": "00000000-0000-4000-8000-000000000002",
      "password": "REPLACE_WITH_TUIC_PASSWORD"
    }
  ],
  "congestion_control": "bbr",
  "zero_rtt_handshake": false,
  "tls": {
    "enabled": true,
    "alpn": ["h3"],
    "certificate_path": "/etc/gust/tls/server.crt",
    "key_path": "/etc/gust/tls/server.key"
  }
}
