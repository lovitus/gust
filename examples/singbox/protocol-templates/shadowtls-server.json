{
  "inbounds": [
    {
      "type": "shadowtls",
      "tag": "shadowtls-in",
      "listen": "0.0.0.0",
      "listen_port": 8446,
      "version": 3,
      "users": [
        {
          "password": "REPLACE_WITH_SHADOWTLS_PASSWORD"
        }
      ],
      "handshake": {
        "server": "origin.example.com",
        "server_port": 443
