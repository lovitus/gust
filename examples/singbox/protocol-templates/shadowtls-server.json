    {
      "type": "shadowsocks",
      "tag": "shadowtls-inner",
      "listen": "127.0.0.1",
      "network": "tcp",
      "method": "2022-blake3-aes-128-gcm",
      "password": "MDEyMzQ1Njc4OWFiY2RlZg=="
    }
  ]
}
