  "chains": [
    {
      "name": "vless-reality-chain",
      "hops": [
        {
          "name": "vless-reality-hop",
          "nodes": [
            {
              "name": "vless-reality",
              "addr": "server.example.com:8443",
              "connector": {
                "type": "singbox",
                "metadata": {
                  "protocol": "vless",
                  "options": {
                    "uuid": "00000000-0000-4000-8000-000000000001",
                    "flow": "xtls-rprx-vision",
                    "tls": {
                      "enabled": true,
                      "server_name": "server.example.com",
                      "utls": {
                        "enabled": true,
                        "fingerprint": "chrome"
                      },
                      "reality": {
                        "enabled": true,
                        "public_key": "REPLACE_WITH_REALITY_PUBLIC_KEY",
                        "short_id": "01234567"
                      }
                    }
                  }
                }
              },
              "dialer": {
                "type": "direct"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "hysteria2-chain",
      "hops": [
        {
          "name": "hysteria2-hop",
          "nodes": [
            {
              "name": "hysteria2",
              "addr": "server.example.com:8444",
              "connector": {
                "type": "singbox",
                "metadata": {
                  "protocol": "hysteria2",
                  "options": {
                    "up_mbps": 100,
                    "down_mbps": 300,
                    "password": "REPLACE_WITH_HYSTERIA2_PASSWORD",
                    "tls": {
                      "enabled": true,
                      "server_name": "server.example.com",
                      "alpn": [
                        "h3"
                      ]
                    }
                  }
                }
              },
              "dialer": {
                "type": "direct"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "tuic-chain",
      "hops": [
        {
          "name": "tuic-hop",
          "nodes": [
            {
              "name": "tuic",
              "addr": "server.example.com:8445",
              "connector": {
                "type": "singbox",
                "metadata": {
                  "protocol": "tuic",
                  "options": {
                    "uuid": "00000000-0000-4000-8000-000000000002",
                    "password": "REPLACE_WITH_TUIC_PASSWORD",
                    "congestion_control": "bbr",
                    "udp_relay_mode": "native",
                    "zero_rtt_handshake": false,
                    "tls": {
                      "enabled": true,
                      "server_name": "server.example.com",
                      "alpn": [
                        "h3"
                      ]
                    }
                  }
                }
              },
